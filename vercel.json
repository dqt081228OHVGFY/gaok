{
  "buildCommand": "pnpm --filter @workspace/gaokao run build",
  "outputDirectory": "artifacts/gaokao/dist/public",
  "framework": null,
  "installCommand": "corepack enable && pnpm install",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "data/raw/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
