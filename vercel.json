{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/gaokao run build && cp -r artifacts/gaokao/dist/public public",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "data/raw/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
